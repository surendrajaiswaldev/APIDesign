# Spring profile to activate (local | dev | prod).
SPRING_PROFILES_ACTIVE=local

# JDBC connection URL.
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# Database credentials. Required in `dev` and `prod`; defaulted to `system`/`password` in `local`.
DB_USERNAME=system
DB_PASSWORD=password

# JWT HMAC signing secret. Must be >= 32 bytes for HS256.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-secret-please-override-in-prod-32b

# OpenTelemetry OTLP endpoint (optional; defaults to localhost:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Prod-only: TLS keystore (PKCS12).
# SSL_KEYSTORE_PATH=/etc/ssl/keystore.p12
# SSL_KEYSTORE_PASSWORD=changeit
