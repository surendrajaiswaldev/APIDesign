# Lombok Configuration for Order Management System
# See src/main/java/com/apidesign/config/LombokConfigurationGuide.java for detailed documentation

# Stop searching in parent directories for lombok.config
config.stopBubbling = true

# Accessors - Disable fluent/chain accessors (keep standard getter/setter)
lombok.accessors.chain = false
lombok.accessors.fluent = false

# Constructor behavior
lombok.allArgsConstructor.suppressConstructorProperties = false

# toString behavior
lombok.toString.includeFieldNames = true
lombok.toString.doNotUseGetters = true

# Equals and HashCode - Call super for inheritance chain
lombok.equalsAndHashCode.callSuper = call
lombok.equalsAndHashCode.doNotUseGetters = true

# Copyable annotations - allow Spring annotations on fields
lombok.copyableAnnotations = org.springframework.beans.factory.annotation.Value, \
                              org.springframework.beans.factory.annotation.Qualifier, \
                              org.springframework.beans.factory.annotation.Autowired

# Experimental: addLombokGeneratedAnnotation
lombok.addLombokGeneratedAnnotation = true

# Logs
lombok.log.fieldName = log
